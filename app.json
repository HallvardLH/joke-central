{
  "expo": {
    "name": "Joke Central",
    "slug": "joke-central",
    "version": "1.6",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "infoPlist": "Tracking used to deliver personalized ads.",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#6F53FD"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.whimsicalworks.jokecentral"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#6F53FD"
      },
      "package": "com.whimsicalworks.jokecentral"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "70759fa4-a8ea-487c-b2b2-0ed3073d440b"
      }
    }
  }
}